# KairosFlow
# Copy to .env for local Docker/dev, or map these values to your cloud secret store.

# Runtime
NODE_ENV=development
PORT=3030
AUTH_TRUST_HOST=true
APP_BASE_URL_FRONT=http://localhost:3030
# Extra origins allowed to load dev-server resources (/_next/*, HMR WebSocket).
# Only needed when the dev stack runs on another machine and you reach it by IP
# or LAN hostname instead of localhost — otherwise hot reload won't connect.
# Comma- or space-separated, e.g. "192.168.1.100 dev-server.local". Dev-only.
APP_DEV_ALLOWED_ORIGINS=

# Docker host port overrides (KairosFlow uses a dedicated range so it can run
# alongside other local stacks — worklist, rayai — without port conflicts)
APP_PORT=3030
INGESTION_API_PORT=3031
AZURITE_BLOB_PORT_HOST=10020
MONGO_PORT_HOST=27030
REDIS_PORT_HOST=6400
REDIS_INSIGHT_PORT_HOST=8031

# Entrypoint roles
# Web/admin container: UI + admin/auth APIs.
# Ingestion container: RIS upload API + LOCAL-APP gateway APIs.
# Jobs container: background queue worker only.
APP_LOAD_UI=true
APP_LOAD_HTTP=true
APP_LOAD_ADMIN_API=true
APP_LOAD_INGESTION_API=true
APP_LOAD_GATEWAY_API=true
APP_LOAD_JOBS=false
APP_JOBS_HEALTH_ENABLED=true
APP_JOBS_HEALTH_HOST=0.0.0.0
APP_JOBS_HEALTH_PORT=8081

# MongoDB
MONGO_USERNAME=kairosflow_user
MONGO_PASSWORD=kairosflow_pass_local
DATABASE_URL=mongodb://kairosflow_user:kairosflow_pass_local@mongo-custeio:27017/kairosflow?authSource=admin

# Redis
REDIS_HOST=redis-custeio
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass_local
REDIS_URL=redis://:redis_pass_local@redis-custeio:6379

# Auth and secrets
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# Server-side HMAC secret for API tokens. Rotating this invalidates all existing tokens.
# Generate with: openssl rand -hex 32
APP_TOKEN_PEPPER=
# Encrypts secrets stored at rest that the app must decrypt later to use (e.g.
# a Store's Alloy apiKey). Rotating this makes every previously encrypted
# secret undecryptable — back up existing Store apiKeys before rotating.
# Generate with: openssl rand -base64 32
APP_SECRETS_ENCRYPTION_KEY=
# Platform AI
# Provider, model and key that run EVERY organization's analyses and chat turns:
# we pay the provider and charge per exam. There is no per-organization key in
# v1 — the organization screen has no provider fields.
PLATFORM_AI_PROVIDER=
PLATFORM_AI_MODEL=
PLATFORM_AI_API_KEY=

# Optional fallback, tried only when the primary provider rejects the call.
# Needs provider + key to count (an empty model uses the provider's default).
# Left empty there is no fallback: the primary's failure is reported as it is,
# with no extra attempt.
PLATFORM_AI_FALLBACK_PROVIDER=
PLATFORM_AI_FALLBACK_MODEL=
PLATFORM_AI_FALLBACK_API_KEY=

# Margin over the provider cost, and the exchange rate, used to bill. Starting
# point only: once the rate card is saved in System > AI rates, that is what
# applies.
PLATFORM_AI_MARGIN=1.3
PLATFORM_AI_USD_BRL=5.2

# Claude API (Anthropic Console, a separate account from the Claude Pro subscription): used by
# scripts/dev/ai-eval.ts and, later, by the assistant. Server-side only; a secret. Do NOT export it
# in your shell profile: Claude Code would then bill the API instead of the subscription.
ANTHROPIC_API_KEY=

# Alloy (PDV) — developer/integrator credentials
# See docs/features/alloy-api.md. Both are system-wide (one KairosFlow install =
# one integrator with Alloy), unlike Organizations.posApiKey/posStoreId which are
# per-store. ALLOY_INTEGRATOR_TOKEN comes from Área de desenvolvedores > gerar
# token. ALLOY_API_HOST is "alloy.al", confirmed 2026-09-17 against a real store —
# used as https://api.alloy.al/api/... in every Alloy request.
ALLOY_INTEGRATOR_TOKEN=
ALLOY_API_HOST=alloy.al

# Webhook bridge (docs/features/webhook-bridge.md): the always-on receiver (Vercel + Atlas) that
# keeps Alloy's deliveries while this machine is off. The `bridge.pull` cron brings them in. Secret.
BRIDGE_MONGODB_URI=
BRIDGE_MONGODB_DB=bridge

# Demo admin
# Used by npm run demo:data for local development/demo data only.
APP_USER_EMAIL=admin@example.com
APP_USER_PASSWORD=change-me
DEMO_DATA_ORGANIZATION_COUNT=2
DEMO_DATA_USER_COUNT=1
DEMO_DATA_EXAM_COUNT=40
DEMO_DATA_GATEWAY_QUARANTINE_COUNT=35

# Production first-admin bootstrap
# Used by npm run bootstrap:admin. Remove these values after the first login.
BOOTSTRAP_ADMIN_CONFIRM=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# Azure Blob Storage
# DEV Docker default. For host hot-reload, dev.sh writes .env.local with BlobEndpoint=http://127.0.0.1:10020/devstoreaccount1.
APP_AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite-custeio:10000/devstoreaccount1;
APP_SYSTEM_ASSETS_CONTAINER=kairosflow-system-assets

# File upload and API limits

# Bull queue
APP_BULL_WORKER_CONCURRENCY=3
APP_BULL_KEEP_FAILED_JOBS=1000
APP_BULL_FAILED_JOB_TTL_DAYS=7
APP_BULL_CLEANUP_INTERVAL_HOURS=6

# Rate limits
APP_RATE_LIMIT_DEFAULT_PER_MIN=120
APP_RATE_LIMIT_HEALTH_PER_MIN=600
APP_RATE_LIMIT_AUTH_PER_MIN=120
APP_RATE_LIMIT_LOGIN_PER_MIN=10
APP_RATE_LIMIT_CLAIM_PER_MIN=10

# Health checks
APP_HEALTHCHECK_PING_TIMEOUT_MS=3000
APP_HEALTHCHECK_HTTP_TIMEOUT_MS=8000
APP_WORKER_QUEUE_STATS_INTERVAL_MS=60000
APP_WORKER_HEARTBEAT_INTERVAL_MS=15000
APP_WORKER_HEARTBEAT_MAX_AGE_MS=60000
APP_WORKER_HEARTBEAT_PATH=/tmp/worker-heartbeat

# Logging
APP_LOG_LEVEL=info
APP_LOG_FORMAT=pretty
APP_SERVICE_NAME=kairosflow

# Sentry
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=0

# Build helpers
ANALYZE=false
NODE_ARGS=
VERSION=
RUNTIME_BASE_IMAGE=kairosflow-runtime-base:node22
PROD_BUILD_TARGET=all
PROD_SKIP_VERIFY=false
PROD_SKIP_DOCKER=false
PROD_CLEAN=false
PROD_PACKAGE_LOCAL_APP=false
PROD_PUSH=false
PROD_RUNTIME_BASE_IMAGE_TAG=kairosflow-runtime-base:node22
PROD_CLOUD_IMAGE_TAG=
PROD_LOCAL_APP_IMAGE_TAG=
PROD_REGISTRY=registry.pacs-worklist.com.br
PROD_TESTING_REPOSITORY=testing.pacs-worklist.com.br/app
TESTING_AZURE_STORAGE_CONNECTION_STRING=

# Playwright e2e
E2E_BASE_URL=http://localhost:3030
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
E2E_USER_NEW_PASSWORD=Admin12345!
E2E_SKIP_DOCKER_DEPS=false
E2E_NO_DOCKER_DEPS=false
E2E_KEEP_DOCKER_DEPS=false
E2E_NO_SERVER=false

# SEFAZ smoke test only (scripts/dev/sefaz-dist-nsu.ts) — password of the e-CNPJ A1 .pfx.
# Not read by the app; remove once certificate custody is decided.
SEFAZ_PFX_PASSWORD=

# "Buscar na SEFAZ" source: simulated replays XML files from a folder (no real SEFAZ calls).
SEFAZ_SOURCE=simulated
SEFAZ_SIMULATED_DIR=
SEFAZ_SYNC_COOLDOWN_MINUTES=60

# "Sincronizar cardápio" (pos.catalog.sync): minimum minutes between two syncs of one store.
ALLOY_CATALOG_SYNC_COOLDOWN_MINUTES=10
