{
  "name": "custeio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:host": "bash ./dev.sh",
    "dev:lan": "next dev -H $(ipconfig getifaddr en0)",
    "docker:base:build": "docker build -f Dockerfile.runtime-base -t custeio-runtime-base:node22 .",
    "docker:dev:up": "npm run docker:base:build && docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod:up": "npm run docker:base:build && docker compose -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "prod:build": "node scripts/prod/build.mjs",
    "prod:build:cloud": "node scripts/prod/build.mjs --target=cloud",
    "entrypoint": "tsx scripts/entrypoint.ts",
    "analyze": "ANALYZE=true next build",
    "docs:pdf": "node scripts/dev/render-docs-pdf.mjs",
    "worker": "tsx scripts/worker.ts",
    "bootstrap:admin": "node scripts/prod/bootstrap-admin.js",
    "ops:backup": "bash scripts/ops/backup-mongo.sh",
    "ops:restore": "bash scripts/ops/restore-mongo.sh",
    "migrate": "echo \"Migrations are not enabled yet in this environment.\"",
    "migrate:rollback": "echo \"Migrations are not enabled yet in this environment.\"",
    "migrate:status": "echo \"Migrations are not enabled yet in this environment.\"",
    "migrate:create": "echo \"Migrations are not enabled yet in this environment.\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "spellcheck": "cspell \"**/*.{ts,tsx,js,jsx,mjs,md}\" --no-progress",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yaml,yml}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:ci": "jest --passWithNoTests --ci --coverage=false",
    "test:coverage": "jest --passWithNoTests --coverage",
    "enforce:feature-url-style": "bash scripts/check-feature-url-style.sh",
    "enforce:features": "bash scripts/check-feature-endpoints.sh",
    "enforce:worker-imports": "tsx scripts/check-worker-imports.mjs",
    "verify": "npm run enforce:features && npm run enforce:feature-url-style && npm run enforce:worker-imports && npm run lint && npm run typecheck && npm run test:ci",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "e2e:smoke": "playwright test --config e2e/playwright.config.ts e2e/tests/smoke.spec.ts e2e/tests/ui-core.spec.ts e2e/tests/api-unauth.spec.ts e2e/tests/api-authenticated.spec.ts",
    "e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@azure/storage-blob": "^12.27.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/nextjs": "^10.55.0",
    "@sentry/node": "^10.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "browser-image-compression": "^2.0.2",
    "bull": "^4.16.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cpf-cnpj-validator": "^2.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "fast-xml-parser": "^5.11.1",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.4.0",
    "lucide-react": "^0.511.0",
    "mongoose": "^9.9.4",
    "next": "^16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "pm2": "^7.0.1",
    "rate-limiter-flexible": "^11.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-dropzone": "^20.1.1",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.5",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.3",
    "unpdf": "^1.8.1",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "cspell --no-must-find-files --no-progress",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix",
      "cspell --no-must-find-files --no-progress"
    ],
    "*.md": [
      "prettier --write",
      "cspell --no-must-find-files --no-progress"
    ],
    "*.{json,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bull": "^3.15.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "cspell": "^10.0.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8",
    "prettier": "^3.8.2",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.60.0"
  }
}
